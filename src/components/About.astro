---
import { siteConfig, type Lang } from "../config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = siteConfig.content[lang];
---

<section id="about" class="pt-1 sm:pt-1.5 md:pt-2.5 pb-8 sm:pb-12 md:pb-16 lg:pb-24 pl-8 sm:pl-12 md:pl-0 pr-8 sm:pr-12 md:pr-16 lg:pr-24">
  <!-- Mobile only: the fixed sidebar menu is the heading from md up. -->
  <div class="md:hidden mb-8">
    <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
      {content.aboutHeading}
    </h2>
    <div
      class="w-[75px] h-[5px] mt-2 rounded-full"
      style={`background-color: ${siteConfig.accentColor}`}
    >
    </div>
  </div>

  <div class="space-y-8">
    {content.aboutMe.map((paragraph) => (
      <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-600">
        {paragraph}
      </p>
    ))}
  </div>
</section>
