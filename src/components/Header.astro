---
import { siteConfig, langMeta, type Lang } from "../config";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = siteConfig.content[lang];
const allLangs = Object.entries(langMeta) as [Lang, { label: string; href: string }][];

// These are the section titles themselves — the sections no longer render their
// own heading on desktop, this menu is it. Only list a section that renders.
const navLinks = [
  { href: "#hero", label: content.sections.hello, show: true },
  { href: "#articles", label: content.sections.articles, show: true },
  { href: "#about", label: content.aboutHeading, show: true },
  { href: "#experience", label: content.sections.experience, show: content.experience.length > 0 },
  { href: "#education", label: content.sections.education, show: content.education.length > 0 },
].filter((link) => link.show);
---

<!-- Desktop: the section titles, as a fixed menu that slides so the current
     section's title stays on the reading line. -->
<header
  id="header-desktop"
  class="hidden md:flex md:flex-col fixed inset-y-0 left-0 z-50 w-[min(30vw,440px)]"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <!-- flex-1 + min-h-0 reserves real space for the language switcher below and
       lets overflow:hidden actually clip the sliding list above it, however
       many items the menu ends up holding. -->
  <nav class="menu-viewport flex-1 min-h-0">
    <ul class="menu-list" id="menu-list">
      {navLinks.map((link) => (
        <li class="menu-item">
          <a href={link.href} class="menu-link" data-menu-link>
            {link.label}
          </a>
          <span class="menu-accent" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </nav>

  <nav class="flex gap-3 px-10 py-10">
    {allLangs.map(([key, meta]) => (
      <a
        href={meta.href}
        class={`text-sm font-mono uppercase tracking-widest transition-colors ${
          key === lang
            ? "text-gray-800 font-semibold"
            : "text-gray-400 hover:text-gray-800"
        }`}
        aria-current={key === lang ? "page" : undefined}
      >
        {meta.label}
      </a>
    ))}
  </nav>
</header>

<!-- Mobile: a compact bar naming the section you're in. Tapping it opens the
     full-screen menu below, where the titles get the same weight they have on
     desktop — there's no room for that in a 56px bar. -->
<header
  id="header-mobile"
  class="md:hidden fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <button
    id="mobile-menu-trigger"
    type="button"
    class="mobile-trigger"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label={content.nav.menu}
  >
    <span class="mobile-trigger-text">
      <span data-mobile-current>{navLinks[0].label}</span>
      <span class="mobile-trigger-accent" aria-hidden="true"></span>
    </span>

    <svg
      class="mobile-trigger-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 7h16" />
      <path d="M4 12h16" />
      <path d="M4 17h16" />
    </svg>
  </button>
</header>

<!-- Sibling of the bar above, not a child, so it needs its own accent variable. -->
<div
  id="mobile-menu"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label={content.nav.menu}
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="mobile-menu-head">
    <button
      id="mobile-menu-close"
      type="button"
      class="mobile-menu-close"
      aria-label={content.nav.close}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path d="M6 6l12 12" />
        <path d="M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav class="mobile-menu-nav">
    <ul>
      {navLinks.map((link) => (
        <li class="mobile-menu-item">
          <a href={link.href} class="mobile-menu-link" data-mobile-link>
            {link.label}
          </a>
          <span class="mobile-menu-accent" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </nav>

  <nav class="mobile-menu-langs">
    {allLangs.map(([key, meta]) => (
      <a
        href={meta.href}
        class={`text-sm font-mono uppercase tracking-widest transition-colors ${
          key === lang
            ? "text-gray-800 font-semibold"
            : "text-gray-400 hover:text-gray-800"
        }`}
        aria-current={key === lang ? "page" : undefined}
      >
        {meta.label}
      </a>
    ))}
  </nav>
</div>

<script is:inline>
  function initMobileHeaderBackdrop() {
    const header = document.getElementById("header-mobile");
    if (!header) return;

    function update() {
      if (window.scrollY > 100) {
        header.classList.add("bg-white/95", "backdrop-blur-sm");
      } else {
        header.classList.remove("bg-white/95", "backdrop-blur-sm");
      }
    }

    window.addEventListener("scroll", update, { passive: true });
    // Run once: the page can load already scrolled (a #hash deep link, or the
    // browser restoring a position), and the bar would stay transparent with
    // body text running straight through the section title.
    update();
  }

  // One scroll-spy drives both menus: it decides which section is current, then
  // the desktop list slides to it and the mobile bar renames itself to match.
  function initSectionMenus() {
    const desktopList = document.getElementById("menu-list");
    const desktopLinks = Array.from(document.querySelectorAll("[data-menu-link]"));
    const mobileLinks = Array.from(document.querySelectorAll("[data-mobile-link]"));
    const currentLabel = document.querySelector("[data-mobile-current]");

    const orderedLinks = desktopLinks.length > 0 ? desktopLinks : mobileLinks;
    const sections = orderedLinks
      .map((link) => {
        const id = link.getAttribute("href")?.slice(1);
        return id ? document.getElementById(id) : null;
      })
      .filter((el) => el !== null);

    if (sections.length === 0) return;

    function currentIndex() {
      const readingLine = window.scrollY + window.innerHeight * 0.35;
      let index = 0;

      sections.forEach((el, i) => {
        const top = el.getBoundingClientRect().top + window.scrollY;
        if (top <= readingLine) index = i;
      });

      // The last section can be shorter than the viewport, in which case its
      // top never crosses the reading line — pin it once we hit the bottom.
      const atBottom =
        window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
      return atBottom ? sections.length - 1 : index;
    }

    function markActive(links, activeIndex) {
      links.forEach((link, index) => {
        const isActive = index === activeIndex;
        link.classList.toggle("is-active", isActive);
        if (isActive) {
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("aria-current");
        }
      });
    }

    function update() {
      const activeIndex = currentIndex();

      markActive(desktopLinks, activeIndex);
      markActive(mobileLinks, activeIndex);

      const activeLink = orderedLinks[activeIndex];
      if (currentLabel && activeLink) {
        currentLabel.textContent = activeLink.textContent.trim();
      }

      // Desktop only. While the sidebar is hidden these measure 0, which is
      // harmless — the resize listener recomputes when it comes back.
      if (desktopList && desktopList.children.length > 0) {
        const itemHeight = desktopList.children[0].getBoundingClientRect().height;
        const gap = parseFloat(getComputedStyle(desktopList).rowGap) || 0;
        const centerOfActive = activeIndex * (itemHeight + gap) + itemHeight / 2;
        const anchor = window.innerHeight * 0.4;

        desktopList.style.transform = `translateY(${anchor - centerOfActive}px)`;
      }
    }

    window.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update, { passive: true });
    update();
  }

  function initMobileMenu() {
    const trigger = document.getElementById("mobile-menu-trigger");
    const menu = document.getElementById("mobile-menu");
    const closeButton = document.getElementById("mobile-menu-close");
    if (!trigger || !menu) return;

    function openMenu() {
      menu.classList.add("is-open");
      trigger.setAttribute("aria-expanded", "true");
      // Stop the page behind the overlay from scrolling under the finger.
      document.body.style.overflow = "hidden";
      closeButton?.focus();
    }

    function closeMenu({ restoreFocus = true } = {}) {
      menu.classList.remove("is-open");
      trigger.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      if (restoreFocus) trigger.focus();
    }

    trigger.addEventListener("click", openMenu);
    closeButton?.addEventListener("click", () => closeMenu());

    menu.querySelectorAll("[data-mobile-link]").forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.getAttribute("href")?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;

        // Don't let the anchor scroll on its own: the body is still locked at
        // this point, and a body with overflow:hidden cannot scroll, so the
        // jump would be swallowed and the page would sit where it was.
        event.preventDefault();
        closeMenu({ restoreFocus: false });

        // Reading a layout property flushes the unlock synchronously, so the
        // scroll below runs against a body that can actually move.
        void document.body.offsetHeight;

        target.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${id}`);
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.classList.contains("is-open")) {
        closeMenu();
      }
    });
  }

  function init() {
    initMobileHeaderBackdrop();
    initSectionMenus();
    initMobileMenu();
  }

  document.addEventListener("DOMContentLoaded", init);
  document.addEventListener("astro:page-load", init);
</script>

<style>
  html {
    scroll-behavior: smooth;
  }

  /* ── Desktop sidebar ── */

  .menu-viewport {
    position: relative;
    height: 100%;
    overflow: hidden;
  }

  .menu-list {
    /* Longest title is 11 monospace characters ("Experiência"), and IBM Plex
       Mono advances 0.6em per character — so the title can be as large as the
       column width divided by ~6.6, capped at the original heading's text-7xl.
       Recalculate this if the sidebar's w-[min(30vw,440px)] changes again. */
    --title-size: min(4.5rem, calc(4.55vw - 9.7px));

    position: absolute;
    top: 0;
    left: 2rem;
    right: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: transform 0.55s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* Constant height, active or not: the title's font-size must never move the
     items, or the slide would land in the wrong place while it animates. The
     active title simply grows inside its fixed box. */
  .menu-item {
    height: calc(var(--title-size) * 1.15 + 13px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .menu-link {
    display: block;
    font-size: 1rem;
    line-height: 1.1;
    font-weight: 500;
    color: #9ca3af;
    white-space: nowrap;
    transition:
      font-size 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      color 0.3s ease;
  }

  .menu-link:hover {
    color: #4b5563;
  }

  /* Same weight, colour and scale as the section <h2> this replaced. */
  .menu-link.is-active {
    font-size: var(--title-size);
    font-weight: 700;
    color: #111827;
  }

  /* The accent bar that used to sit under each section heading — same 75x5px. */
  .menu-accent {
    display: block;
    height: 5px;
    width: 0;
    margin-top: 0;
    border-radius: 9999px;
    background-color: var(--accent-color);
    transition:
      width 0.45s cubic-bezier(0.4, 0, 0.2, 1),
      margin-top 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .menu-item:has(.is-active) .menu-accent {
    width: 75px;
    margin-top: 0.5rem;
  }

  /* ── Mobile trigger bar ── */

  .mobile-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.75rem 2rem 1rem;
    text-align: left;
    color: #111827;
    cursor: pointer;
  }

  .mobile-trigger-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .mobile-trigger-text > span:first-child {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .mobile-trigger-accent {
    display: block;
    width: 40px;
    height: 4px;
    margin-top: 0.375rem;
    border-radius: 9999px;
    background-color: var(--accent-color);
  }

  .mobile-trigger-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    color: #4b5563;
  }

  /* ── Mobile full-screen menu ── */

  .mobile-menu {
    /* Longest title is 11 monospace characters; same 0.6em advance as the
       sidebar, against the full viewport minus this panel's 2rem padding. */
    --mobile-title-size: min(3rem, calc(15.15vw - 9.7px));

    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    flex-direction: column;
    background-color: #ffffff;
    padding: 1rem 2rem 2.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-10px);
    transition:
      opacity 0.28s ease,
      transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.28s;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  /* Not Tailwind's md:hidden — a scoped class beats it on specificity and the
     panel would stay visible on desktop. */
  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu-head {
    display: flex;
    justify-content: flex-end;
  }

  .mobile-menu-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.75rem;
    color: #4b5563;
    cursor: pointer;
  }

  .mobile-menu-close svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .mobile-menu-nav {
    flex: 1;
    display: flex;
    align-items: center;
    min-height: 0;
    overflow-y: auto;
  }

  .mobile-menu-nav ul {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
  }

  .mobile-menu-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mobile-menu-link {
    display: block;
    font-size: var(--mobile-title-size);
    line-height: 1.1;
    font-weight: 700;
    color: #9ca3af;
    white-space: nowrap;
    transition: color 0.25s ease;
  }

  .mobile-menu-link.is-active {
    color: #111827;
  }

  .mobile-menu-accent {
    display: block;
    height: 5px;
    width: 0;
    margin-top: 0;
    border-radius: 9999px;
    background-color: var(--accent-color);
    transition:
      width 0.35s cubic-bezier(0.4, 0, 0.2, 1),
      margin-top 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .mobile-menu-item:has(.is-active) .mobile-menu-accent {
    width: 75px;
    margin-top: 0.5rem;
  }

  .mobile-menu-langs {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-list,
    .menu-link,
    .menu-accent,
    .mobile-menu,
    .mobile-menu-link,
    .mobile-menu-accent {
      transition: none;
    }
  }
</style>
